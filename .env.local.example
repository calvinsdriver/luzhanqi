# Copy to .env.local and fill in from your Supabase project settings (Project Settings > API).

# Client-safe: used only for the anon-key Realtime subscription to `game_events`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_, never import from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
